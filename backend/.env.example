# ── AI Provider — priority: TokenFactory → Ollama → Groq ─────────────────────

# 1. TokenFactory (primary) — tokenfactory.iamsaif.ai
TF_API_KEY=
TF_MODEL=openai/gpt-oss-120b
TF_BASE_URL=https://api.tokenfactory.iamsaif.ai/v1

# 2. Ollama (local — fallback when TokenFactory is down)
OLLAMA_URL=
OLLAMA_MODEL=gemma4:31b

# 3. Groq (last resort fallback — groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL is required for accounts, source revisions and deployment jobs.
DATABASE_URL=postgresql://infrapilot:infrapilot@localhost:5432/infrapilot

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Config ────────────────────────────────────────────────────────────────────
CONFIG_FILE=config/platforms.json

# ── GitHub ────────────────────────────────────────────────────────────────────
# Optional: PAT for repository operations (can also be set via onboarding UI)
GITHUB_PAT=ghp_...

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create at github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# ── GitLab OAuth ──────────────────────────────────────────────────────────────
# Create at gitlab.com/-/profile/applications (or your self-hosted GitLab)
# Scopes needed: read_user
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://localhost:3000/api/auth/gitlab/callback
# For self-hosted GitLab, set this to your instance URL (e.g. https://gitlab.company.com)
GITLAB_URL=https://gitlab.com

# ── Email OTP ─────────────────────────────────────────────────────────────────
# Resend (resend.com) — for OTP emails
RESEND_API_KEY=
# A sender address on your verified Resend domain, e.g. Meridian <hello@example.com>
EMAIL_FROM=
# Comma-separated invited email addresses. Required in production early access.
BETA_ALLOWED_EMAILS=

# ── WhatsApp OTP ──────────────────────────────────────────────────────────────
# Twilio (twilio.com/whatsapp) — optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Launch release (APP_ENV=production enforces email delivery, HTTPS and keys)
APP_ENV=development
ENCRYPTION_KEY=
SOURCE_DIR=data/sources
ENABLE_LEGACY_SINGLE_TENANT=false

# Worker only: operator-owned managed Kubernetes cluster and isolated builder.
# A hosting account and these resources must be provisioned before deployments.
APP_DOMAIN=
IMAGE_REPOSITORY=
IMAGE_PULL_SECRET=
BUILDKIT_HOST=
BUILDKIT_TLS_DIR=
INGRESS_CLASS=
RUNTIME_CLASS=
APP_TLS_SECRET=
PLATFORM_NAMESPACE=meridian-system
# KUBECONFIG=/run/meridian/kubeconfig
